<Window x:Class="AppealsFinal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppealsFinal"
        Title="Система обращений граждан – Администрация г. Слободского" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">
    <Window.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#2C3E50" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="📋 Электронная приёмная администрации города Слободского" 
                       FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Панель ролей и фильтров -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="Роль:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbRoles" Width="150" SelectionChanged="CmbRoles_SelectionChanged" Margin="0,0,20,0">
                        <ComboBoxItem Content="HeadOfDepartment" IsSelected="True"/>
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="Executor"/>
                    </ComboBox>

                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbStatusFilter" Width="120" SelectionChanged="CmbStatusFilter_SelectionChanged" Margin="0,0,20,0"/>

                    <TextBlock Text="Дата с:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <DatePicker x:Name="dpDateFrom" SelectedDateChanged="DateFilterChanged" Width="110" Margin="0,0,10,0"/>
                    <TextBlock Text="по:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <DatePicker x:Name="dpDateTo" SelectedDateChanged="DateFilterChanged" Width="110" Margin="0,0,20,0"/>

                    <Button x:Name="btnExport" Content="📎 Экспорт в Excel" Width="130" Click="BtnExport_Click" Background="#27AE60" Foreground="White" Margin="0,0,10,0"/>
                    <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="100" Click="BtnRefresh_Click" Background="#3498DB" Foreground="White"/>
                    <Button x:Name="btnRegisterCitizen" Content="📝 Регистрация гражданина" Width="180" Click="BtnRegisterCitizen_Click" Background="#8E44AD" Foreground="White"/>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock Text="Поиск по фамилии:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearchCitizen" Width="150" Margin="0,0,20,0" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="Поиск в тексте:" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearchContent" Width="200" Margin="0,0,20,0" TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="btnClearSearch" Content="❌ Очистить" Width="80" Click="BtnClearSearch_Click" Background="#E67E22" Foreground="White"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Панель CRUD кнопок -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAdd" Content="➕ Добавить" Width="100" Height="35" Margin="5" Click="BtnAdd_Click" Background="#27AE60" Foreground="White"/>
                <Button x:Name="btnUpdate" Content="✏️ Изменить" Width="100" Height="35" Margin="5" Click="BtnUpdate_Click" Background="#F39C12" Foreground="White"/>
                <Button x:Name="btnDelete" Content="🗑️ Удалить" Width="100" Height="35" Margin="5" Click="BtnDelete_Click" Background="#E74C3C" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#E8F5E9" CornerRadius="6" Padding="10,5" Margin="5">
                    <TextBlock x:Name="txtStatNew" Text="📌 Новых: 0" FontWeight="Bold"/>
                </Border>
                <Border Background="#FFF3E0" CornerRadius="6" Padding="10,5" Margin="5">
                    <TextBlock x:Name="txtStatInWork" Text="⚙️ В работе: 0" FontWeight="Bold"/>
                </Border>
                <Border Background="#E3F2FD" CornerRadius="6" Padding="10,5" Margin="5">
                    <TextBlock x:Name="txtStatCompleted" Text="✅ Выполнено: 0" FontWeight="Bold"/>
                </Border>
                <Border Background="#FFEBEE" CornerRadius="6" Padding="10,5" Margin="5">
                    <TextBlock x:Name="txtStatRejected" Text="❌ Отклонено: 0" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Таблица обращений -->
        <DataGrid x:Name="dgAppeals" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="DgAppeals_SelectionChanged" Margin="0,0,0,10"
                  AlternatingRowBackground="#FAFAFA" RowBackground="White" BorderBrush="#D0D7DE">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding AppealID}" Width="50"/>
                <DataGridTextColumn Header="Гражданин" Binding="{Binding CitizenFullName}" Width="150"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding AppealType}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding AppealDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding ResponseDeadline, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding ExecutorName}" Width="130"/>
                <DataGridTextColumn Header="Содержание" Binding="{Binding Content}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Пагинация -->
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,0" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="&lt;&lt;" Width="40" Margin="2" Click="FirstPage_Click" Background="#34495E" Foreground="White"/>
                <Button Content="&lt;" Width="40" Margin="2" Click="PrevPage_Click" Background="#34495E" Foreground="White"/>
                <TextBox x:Name="txtPageNumber" Width="40" TextAlignment="Center" IsReadOnly="True" Background="#ECF0F1"/>
                <TextBlock Text="/" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtTotalPages" Width="40" TextAlignment="Center" IsReadOnly="True" Background="#ECF0F1"/>
                <Button Content="&gt;" Width="40" Margin="2" Click="NextPage_Click" Background="#34495E" Foreground="White"/>
                <Button Content="&gt;&gt;" Width="40" Margin="2" Click="LastPage_Click" Background="#34495E" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>