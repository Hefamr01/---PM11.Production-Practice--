<Window x:Class="AppealsFinal.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация гражданина" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Фамилия:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtLastName" Grid.Row="0" Grid.Column="1" Margin="5" Height="30"/>
        <TextBlock x:Name="txtLastNameError" Grid.Row="1" Grid.Column="1" Foreground="Red" FontSize="11" Margin="5,0"/>

        <TextBlock Text="Имя:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtFirstName" Grid.Row="2" Grid.Column="1" Margin="5" Height="30"/>
        <TextBlock x:Name="txtFirstNameError" Grid.Row="3" Grid.Column="1" Foreground="Red" FontSize="11" Margin="5,0"/>

        <TextBlock Text="Отчество:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtPatronymic" Grid.Row="4" Grid.Column="1" Margin="5" Height="30"/>

        <TextBlock Text="Адрес:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtAddress" Grid.Row="5" Grid.Column="1" Margin="5" Height="30"/>
        <TextBlock x:Name="txtAddressError" Grid.Row="6" Grid.Column="1" Foreground="Red" FontSize="11" Margin="5,0"/>

        <TextBlock Text="Телефон:" Grid.Row="7" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtPhone" Grid.Row="7" Grid.Column="1" Margin="5" Height="30"/>

        <TextBlock Text="Email:" Grid.Row="8" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtEmail" Grid.Row="8" Grid.Column="1" Margin="5" Height="30"/>
        <TextBlock x:Name="txtEmailError" Grid.Row="9" Grid.Column="1" Foreground="Red" FontSize="11" Margin="5,0"/>

        <TextBlock Text="Пароль:" Grid.Row="10" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="10" Grid.Column="1" Margin="5" Height="30"/>
        <TextBlock x:Name="txtPasswordError" Grid.Row="11" Grid.Column="1" Foreground="Red" FontSize="11" Margin="5,0"/>

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnRegister" Content="Зарегистрироваться" Width="140" Height="35" Margin="5" Click="BtnRegister_Click" Background="#27AE60" Foreground="White"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Margin="5" Click="BtnCancel_Click" Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>